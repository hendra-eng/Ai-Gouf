# ============================================================
# GOUF ACCOUNTING — Accounting Core V2 / Production Security
# ============================================================
# Salin variabel yang relevan ke .env environment Anda.

# development | production
APP_ENV=development

# Development saja. WAJIB false di production.
ALLOW_ANONYMOUS_DEV=true
ALLOW_FALLBACK_ADMIN=true

# WAJIB random/rahasia di production. Contoh generate:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRE_HOURS=12

# PostgreSQL direkomendasikan untuk production.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/gouf_accounting
DATABASE_URL=sqlite:///ai_gouf.db

# Frontend: mock/sample data hanya untuk demo/development.
# Di production set false.
NEXT_PUBLIC_DEMO_MODE=true

# Jika FastAPI terpisah domain dari Next.js, isi URL. Jika memakai rewrite
# next.config.mjs, biarkan kosong.
NEXT_PUBLIC_API_BASE_URL=
