# ============================================================
# GOUF ACCOUNTING BACKEND -- Konfigurasi Auth (JWT) & Database
# ============================================================
# Salin file ini jadi ".env" di folder yang sama (backend/.env), lalu isi
# nilai sebenarnya. File ".env" TIDAK pernah di-commit (sudah masuk
# .gitignore) -- file INI (".env.example") yang boleh di-commit sebagai
# contoh/template.

# development | production
# - development: boleh pakai fallback anonymous/admin di bawah supaya
#   workflow lokal tetap jalan tanpa perlu login dulu.
# - production: WAJIB JWT valid untuk semua endpoint yang butuh login,
#   ALLOW_ANONYMOUS_DEV & ALLOW_FALLBACK_ADMIN otomatis nonaktif.
APP_ENV=development

# Development saja -- WAJIB "false" di production.
ALLOW_ANONYMOUS_DEV=true
ALLOW_FALLBACK_ADMIN=true

# ============================================================
# JWT (dipakai baik oleh sistem lama modules/auth.py MAUPUN fitur baru
# /api/v1/auth/... di modules/auth_v1.py -- SATU secret & token yang sama)
# ============================================================
# WAJIB diisi random & rahasia di production. Contoh generate:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
# Berapa jam token berlaku sebelum user harus login ulang.
JWT_EXPIRE_HOURS=12

# ============================================================
# DATABASE -- PostgreSQL (direkomendasikan/dipakai untuk fitur auth ini)
# ============================================================
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/gouf_accounting

# Alternatif untuk development lokal cepat TANPA server PostgreSQL
# terpisah (data disimpan di file backend/ai_gouf.db) -- nonaktifkan baris
# DATABASE_URL postgresql di atas (kasih tanda "#") kalau mau pakai ini:
# DATABASE_URL=sqlite:///ai_gouf.db
