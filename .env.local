# [SEMENTARA] Port 8000 (dan sempat 8001 juga) di komputer ini nyangkut
# oleh proses lama yang tidak bisa dimatikan (taskkill bilang "process not
# found" walau netstat masih menunjukkan port itu LISTENING) -- socket
# phantom Windows yang sepertinya cuma lepas total lewat restart komputer.
# Backend dipindah ke port 8010 lewat variabel ini, dibaca oleh
# next.config.mjs (proxy /api/*) & src/lib/session.ts (middleware.ts +
# /api/session/*).
#
# Kalau nanti port 8000 sudah normal lagi (misal setelah restart komputer),
# file ini AMAN dihapus untuk balik ke default 8000.
BACKEND_URL=http://127.0.0.1:8000
