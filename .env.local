
# [SEMENTARA] Port 8000 (dan sempat 8001 juga) di komputer ini nyangkut
# oleh proses lama yang tidak bisa dimatikan (taskkill bilang "process not
# found" walau netstat masih menunjukkan port itu LISTENING) -- socket
# phantom Windows yang sepertinya cuma lepas total lewat restart komputer.
# Backend dipindah ke port 8010 lewat variabel ini, dibaca oleh
# next.config.mjs (proxy /api/*) & src/lib/session.ts (middleware.ts +
# /api/session/*).
#
# Kalau nanti port 8000 sudah normal lagi (misal setelah restart komputer),
# file ini AMAN dihapus untuk balik ke default 8000.
BACKEND_URL=http://127.0.0.1:8000

# [BARU] Beda dari BACKEND_URL di atas -- itu cuma dibaca SERVER Next.js
# untuk proxy /api/*. Variabel ini dibaca BROWSER (harus prefix
# NEXT_PUBLIC_ supaya ikut ter-bundle ke client) khusus untuk 2 endpoint
# upload berat yang sengaja fetch LANGSUNG ke FastAPI, melewati proxy:
# rekening koran (ImportRekeningKoranModal.tsx) & Bank Feed (agent-ai/lib/
# api.js) -- lihat src/lib/backendUrl.ts untuk detail & alasannya.
#
# Kalau dikosongkan/tidak di-set, kode akan menebak hostname yang sama
# dengan yang dibuka browser + port 8000 (aman untuk dev lokal, TAPI
# SALAH kalau backend tidak sehost/port itu -- mis. backend pindah port,
# atau app diakses dari komputer lain/tunnel/deploy terpisah). Kalau tab
# Bank Feed atau import rekening koran menampilkan "Failed to fetch" /
# "Tidak bisa menghubungi server backend", isi baris ini dengan alamat
# yang BENAR-BENAR bisa dijangkau langsung dari browser, lalu restart:
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
