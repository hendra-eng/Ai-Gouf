CREATE TABLE public.management_users (
	id_user uuid DEFAULT gen_random_uuid() NOT NULL,
	-- [BARU] username/password_hash ditambah supaya tabel ini bisa dipakai
	-- login (dipasang lewat backend/migrations/add_management_users_auth.py,
	-- ditambahkan setelah DDL asli ini ditulis -- draft awal tidak punya
	-- cara untuk otentikasi user sama sekali).
	username varchar(100) NOT NULL,
	password_hash varchar(255) NOT NULL,
	nama_user varchar(255) NOT NULL,
	alamat_user varchar(255) NULL,
	telp_user varchar(255) NULL,
	"role" varchar(50) NOT NULL,
	"access" json NULL,
	created_at timestamptz DEFAULT now() NOT NULL,
	updated_at timestamptz DEFAULT now() NOT NULL,
	deleted_at timestamptz NULL,
	CONSTRAINT management_users_pkey PRIMARY KEY (id_user),
	CONSTRAINT management_users_username_key UNIQUE (username)
);

