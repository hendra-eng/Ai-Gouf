CREATE TABLE public.management_audit_trails (
	id uuid DEFAULT gen_random_uuid() NOT NULL,
	id_user uuid NOT NULL,
	"timestamp" timestamp NOT NULL,
	ip varchar(255) NULL,
	"action" varchar(255) NULL,
	menu varchar(255) NULL,
	created_at timestamptz DEFAULT now() NOT NULL,
	updated_at timestamptz DEFAULT now() NOT NULL,
	deleted_at timestamptz NULL,
	CONSTRAINT management_audit_trails_pkey PRIMARY KEY (id),
	CONSTRAINT fk_audit_trails_user FOREIGN KEY (id_user) REFERENCES public.management_users(id_user) ON DELETE CASCADE
);